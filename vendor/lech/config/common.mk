# Configuration shared by all LECH OS products (Cuttlefish now, Pixel later).
# Only the product partition is changed here: on Cuttlefish the system image is a shared image
# defined by Soong (aosp_shared_system_image), and the product partition's build.prop is loaded last
# by init, so its values win. Changes to AOSP source code live in patches/ of the repository.

include vendor/lech/config/version.mk

# Signing keys (task E2-07): LECH OS test keys instead of the public AOSP test keys. They are created
# outside the repository by tools/etapa2/07-vytvor-kluce.sh and copied here by 06-zostav-lech.sh.
# Every app and the OTA key (otacerts) use them; the build tag becomes "dev-keys".
LECH_KEYS_DIR := vendor/lech-keys/test
ifeq ($(wildcard $(LECH_KEYS_DIR)/platform.x509.pem),)
$(error LECH OS: chýbajú testovacie kľúče v $(LECH_KEYS_DIR) - spustite tools/etapa2/06-zostav-lech.sh)
endif
PRODUCT_DEFAULT_DEV_CERTIFICATE := $(LECH_KEYS_DIR)/testkey
# SELinux recognises the system apps of mainline modules by their certificate (keys.conf: @NETWORK_STACK,
# @SDK_SANDBOX, @BLUETOOTH, @NFC, taken from the directories below). Keep them on the LECH keys.
PRODUCT_MAINLINE_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)
PRODUCT_MAINLINE_BLUETOOTH_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)
PRODUCT_MAINLINE_NFC_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)
# The Bluetooth apps are signed with a certificate of their own module
# (packages/modules/Bluetooth/android/app/certs/com.android.bluetooth, the same as the public AOSP
# "bluetooth" key), while SELinux expects the product's "bluetooth" key. With the LECH keys zygote could
# not set the SELinux context of com.android.bluetooth, Bluetooth crashed and Cuttlefish reported
# VIRTUAL_DEVICE_BOOT_FAILED (5. 11. 2026). Sign both apps of the shared user android.uid.bluetooth with
# the LECH key (module lech_bluetooth_certificate, written into the key directory by 06-zostav-lech.sh).
PRODUCT_CERTIFICATE_OVERRIDES += \
    Bluetooth:lech_bluetooth_certificate \
    BluetoothLegacyMigration:lech_bluetooth_certificate \

# Shown in Settings > About phone > Build number. Non-user builds carry the variant, so a debuggable
# build cannot be mistaken for a release.
LECH_DISPLAY_ID := LECH-OS-$(LECH_VERSION)$(if $(filter user,$(TARGET_BUILD_VARIANT)),,-$(TARGET_BUILD_VARIANT))

PRODUCT_PRODUCT_PROPERTIES += \
    ro.lech.version=$(LECH_VERSION) \
    ro.build.display.id=$(LECH_DISPLAY_ID) \

# Boot animation, generated by tools/make_bootanimation.py. The same animation also as bootanimation-dark.zip:
# when the bootloader passes androidboot.theme=1 (Pixel with the dark theme), the boot animation looks only for
# /product/media/bootanimation-dark.zip and without it shows the AOSP "android" logo (Pixel 9, 7. 11. 2026).
PRODUCT_COPY_FILES += \
    vendor/lech/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation.zip \
    vendor/lech/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation-dark.zip \

# Settings of the Android framework that differ from AOSP (network time server).
PRODUCT_PACKAGES += \
    LechFrameworksResOverlay \

# Init settings of LECH OS: no remote key provisioning by Google, also when the phone's vendor partition
# names the Google server (Pixel). On Cuttlefish the server is removed by a patch (patches/device/google/cuttlefish).
PRODUCT_COPY_FILES += \
    vendor/lech/config/init/init.lech.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/init.lech.rc \

