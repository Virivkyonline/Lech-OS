# Configuration shared by all LECH OS products (Cuttlefish now, Pixel later).
# Only the product partition is changed here: on Cuttlefish the system image is a shared image
# defined by Soong (aosp_shared_system_image), and the product partition's build.prop is loaded last
# by init, so its values win. Changes to AOSP source code live in patches/ of the repository.

include vendor/lech/config/version.mk

# Signing keys (task E2-07): LECH OS test keys instead of the public AOSP test keys. They are created
# outside the repository by tools/etapa2/07-vytvor-kluce.sh and copied here by 06-zostav-lech.sh.
# Every app and the OTA key (otacerts) use them; the build tag becomes "dev-keys".
LECH_KEYS_DIR := vendor/lech-keys/test
ifeq ($(wildcard $(LECH_KEYS_DIR)/platform.x509.pem),)
$(error LECH OS: chýbajú testovacie kľúče v $(LECH_KEYS_DIR) - spustite tools/etapa2/06-zostav-lech.sh)
endif
PRODUCT_DEFAULT_DEV_CERTIFICATE := $(LECH_KEYS_DIR)/testkey
# SELinux recognises system apps of mainline modules by their certificate (keys.conf: @NETWORK_STACK,
# @SDK_SANDBOX, @BLUETOOTH, @NFC). For Bluetooth the build falls back to the public AOSP keys when
# Google's ART module is in the build, so the Bluetooth app signed with the LECH key got the wrong
# SELinux domain, crashed and Cuttlefish reported VIRTUAL_DEVICE_BOOT_FAILED (5. 11. 2026).
# Point all three explicitly at the LECH keys.
PRODUCT_MAINLINE_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)
PRODUCT_MAINLINE_BLUETOOTH_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)
PRODUCT_MAINLINE_NFC_SEPOLICY_DEV_CERTIFICATES := $(LECH_KEYS_DIR)

# Shown in Settings > About phone > Build number. Non-user builds carry the variant, so a debuggable
# build cannot be mistaken for a release.
LECH_DISPLAY_ID := LECH-OS-$(LECH_VERSION)$(if $(filter user,$(TARGET_BUILD_VARIANT)),,-$(TARGET_BUILD_VARIANT))

PRODUCT_PRODUCT_PROPERTIES += \
    ro.lech.version=$(LECH_VERSION) \
    ro.build.display.id=$(LECH_DISPLAY_ID) \

# Boot animation, generated by tools/make_bootanimation.py.
PRODUCT_COPY_FILES += \
    vendor/lech/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation.zip \

# Settings of the Android framework that differ from AOSP (network time server).
PRODUCT_PACKAGES += \
    LechFrameworksResOverlay \

