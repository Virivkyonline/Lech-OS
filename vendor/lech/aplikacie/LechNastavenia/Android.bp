//
// LECH Nastavenia: the settings of LECH OS in the LECH OS design (stage 3). The main sections open the matching
// screens of the Android settings (Settings), which stay in the system and keep doing the work.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LechNastavenia",
    // Apps of the GrapheneOS base the customer of LECH OS does not get (ADR-0012): Auditor (attestation against
    // the GrapheneOS service) and Info (news of the GrapheneOS project).
    // "Updater": the system updater of the base (app.seamlessupdate.client) asks releases.grapheneos.org for
    // GrapheneOS releases. LECH OS is signed with its own keys, so such an update could never install; LECH OS
    // gets its updates from its own packages (tools/etapa2/11-pixel.sh aktualizovat, later its own server).
    overrides: ["Auditor", "InfoApp", "Updater"],
    product_specific: true,
    sdk_version: "current",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["LechUi"],
    dex_preopt: {
        enabled: false,
    },
}
