//
// LECH Nastavenia: the settings of LECH OS in the LECH OS design (stage 3). The main sections open the matching
// screens of the Android settings (Settings), which stay in the system and keep doing the work.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LechNastavenia",
    product_specific: true,
    sdk_version: "current",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["LechUi"],
    // Privileged: sets the dark theme and the LECH colours of the system once (ThemeReceiver).
    privileged: true,
    required: ["privapp_permissions_lech_nastavenia"],
    dex_preopt: {
        enabled: false,
    },
}

// Privileged permissions of LechNastavenia (the theme of the system, ThemeReceiver).
prebuilt_etc {
    name: "privapp_permissions_lech_nastavenia",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-lech-nastavenia.xml",
}
