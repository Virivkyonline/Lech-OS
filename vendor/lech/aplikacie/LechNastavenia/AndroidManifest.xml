<?xml version="1.0" encoding="utf-8"?>
<!-- LECH Nastavenia (LECH OS): the main sections of the settings. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="lech.os.nastavenia">


    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- GooglePlayActivity: the App Store of the GrapheneOS base and whether Google Play services are installed. -->
        <package android:name="app.grapheneos.apps" />
        <package android:name="com.google.android.gms" />
        <package android:name="app.grapheneos.gmscompat" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_nastavenia"
        android:roundIcon="@mipmap/ic_nastavenia"
        android:theme="@style/Theme.Lech"
        android:supportsRtl="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GooglePlayActivity"
            android:exported="false"
            android:label="@string/gplay_title" />

    </application>
</manifest>
