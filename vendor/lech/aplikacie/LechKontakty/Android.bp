//
// LECH Kontakty: the contacts app of LECH OS (stage 3) – contacts, favourites, groups, companies, call history and
// a dial pad in the LECH OS design. It replaces the AOSP Contacts app; calls themselves stay with the Dialer
// (in-call screen). Contacts are stored only on the device (local account), nothing is synced.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LechKontakty",
    product_specific: true,
    sdk_version: "current",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["LechUi"],
    overrides: ["Contacts"],
    required: ["lech_kontakty_default_permissions"],
    dex_preopt: {
        enabled: false,
    },
}

// Runtime permissions granted to the app on the first start (DefaultPermissionGrantPolicy, preinstalled apps only).
prebuilt_etc {
    name: "lech_kontakty_default_permissions",
    product_specific: true,
    sub_dir: "default-permissions",
    src: "default-permissions-lech-kontakty.xml",
}
