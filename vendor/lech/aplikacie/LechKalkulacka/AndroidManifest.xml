<?xml version="1.0" encoding="utf-8"?>
<!-- LECH Kalkulačka (LECH OS): basic and scientific calculator, offline unit conversion. No permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="lech.os.kalkulacka">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_kalkulacka"
        android:roundIcon="@mipmap/ic_kalkulacka"
        android:theme="@style/Theme.Lech"
        android:supportsRtl="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALCULATOR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
