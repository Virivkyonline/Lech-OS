//
// LECH Kalendár: the calendar of LECH OS (stage 3) – month, week, day and agenda views, events with reminders and
// repeats in the calendar provider (a local LECH OS calendar, nothing is synced), reminder notifications and
// tasks, in the LECH OS design. It replaces the AOSP Calendar.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LechKalendar",
    product_specific: true,
    sdk_version: "current",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: ["LechUi"],
    overrides: ["Calendar"],
    required: ["lech_kalendar_default_permissions"],
    dex_preopt: {
        enabled: false,
    },
}

// Runtime permissions granted to the app on the first start (DefaultPermissionGrantPolicy, preinstalled apps only).
prebuilt_etc {
    name: "lech_kalendar_default_permissions",
    product_specific: true,
    sub_dir: "default-permissions",
    src: "default-permissions-lech-kalendar.xml",
}
