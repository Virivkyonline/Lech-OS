<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Components the launcher does not show (packages/apps/Launcher3 AppFilter). -->
    <string-array name="filtered_components">
        <item>com.android.settings/com.android.settings.Settings</item>
        <item>com.android.documentsui/com.android.documentsui.LauncherActivity</item>
        <!-- The Dialer stays for the in-call screen; its launcher entry is replaced by LECH Telefón. -->
        <item>com.android.dialer/com.android.dialer.main.impl.MainActivity</item>
        <!-- The PDF viewer of GrapheneOS renders the PDF files; the launcher shows LECH PDF instead. -->
        <item>app.grapheneos.pdfviewer/app.grapheneos.pdfviewer.PdfViewer</item>
    </string-array>
</resources>
