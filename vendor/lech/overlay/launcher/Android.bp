//
// Launcher3: hides the launcher entries of the AOSP Settings and DocumentsUI. Their places on the home screen take
// the own apps LechNastavenia and LechSubory; Settings and DocumentsUI stay in the system (settings screens, the
// file picker of other apps). Launcher3 AppFilter reads the components from array/filtered_components.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "LechLauncherOverlay",
    product_specific: true,
    sdk_version: "current",
}
