// Resource overlay for the Android framework (framework-res), installed in the product partition.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

runtime_resource_overlay {
    name: "LechFrameworksResOverlay",
    product_specific: true,
    sdk_version: "current",
}
