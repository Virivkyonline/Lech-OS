<?xml version="1.0" encoding="UTF-8"?>
<!--
  LECH OS: device support for the Pixel 9 (task E2-11b), taken from GrapheneOS (ADR-0002: selective adoption
  of proven open-source components). tools/etapa2/12-priprav-pixel.sh copies this file to
  ~/aosp/.repo/local_manifests/ and syncs only these projects. Revisions are pinned: patches/vendor/adevtool
  apply to them and the vendor module is generated with them.

  vendor/adevtool       MIT     generates vendor/google_devices/tokay from the stock factory image of Google
  vendor/state          MIT     state of the system build that adevtool compares the stock images with
  device/google/caimito-kernels/6.1  GPL-2.0 (Linux)  prebuilt kernel of the Pixel 9 family
  packages/apps/CarrierConfig2       MIT     carrier settings (VoLTE, SMS over IMS) from the stock carrier data
  tools/arsclib         MIT     resource tool adevtool uses for the overlays
  external/vanadium     GPL-2.0 (patches), BSD (Chromium)  prebuilt browser and WebView Vanadium (E3-01, ADR-0011)
-->
<manifest>
  <remote name="lech-grapheneos" fetch="https://github.com/GrapheneOS/" />
  <remote name="lech-grapheneos-gitlab" fetch="https://gitlab.com/grapheneos/" />

  <project path="vendor/adevtool" name="adevtool" remote="lech-grapheneos"
           revision="e18930ac9a684e207e5e5f967d285787aa81e0b0" upstream="refs/heads/17" />
  <project path="vendor/state" name="vendor_state" remote="lech-grapheneos" clone-depth="1"
           revision="1469180711293a5852bfda9a5f67b8f53d9828ad" upstream="refs/heads/17" />
  <project path="device/google/caimito-kernels/6.1" name="device_google_caimito-kernels_6.1" remote="lech-grapheneos"
           clone-depth="1" revision="28ab7aa0c96dfd140cc0ad99eba664a6eabb5c23" upstream="refs/heads/17" />
  <project path="packages/apps/CarrierConfig2" name="platform_packages_apps_CarrierConfig2" remote="lech-grapheneos"
           revision="9d56beab5824252e6fcdd09c04726d276343b247" upstream="refs/heads/17" />
  <project path="tools/arsclib" name="platform_tools_arsclib" remote="lech-grapheneos"
           revision="e81e4e7a8e2af31804ad1f4fd100da01a2db9edf" upstream="refs/heads/17" />
  <!-- Vanadium 157.0.8103.50.0 (10. 11. 2026); ~1.2 GB of APKs (arm64 and x86_64) -->
  <project path="external/vanadium" name="platform_external_vanadium" remote="lech-grapheneos-gitlab" clone-depth="1"
           revision="21895d2c134962ba10c4ef2dd894bc9c6437826f" upstream="refs/heads/17" />
</manifest>
