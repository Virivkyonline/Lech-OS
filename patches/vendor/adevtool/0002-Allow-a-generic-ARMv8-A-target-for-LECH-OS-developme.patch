From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Fri, 6 Nov 2026 12:00:00 +0100
Subject: [PATCH 2/2] Allow a generic ARMv8-A target for LECH OS development
 builds

With LECH_PIXEL_GENERIC_CPU set to true the Pixel board uses the target
of the LECH OS GSI (armv8-a, generic CPU, no heap memory tagging), so a
development build reuses the system already compiled for the GSI. Without
the variable nothing changes (ARMv9 with MTE).
---
 config/mk/google_devices/common/BoardConfig-armv9.mk | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/config/mk/google_devices/common/BoardConfig-armv9.mk b/config/mk/google_devices/common/BoardConfig-armv9.mk
index b3040800..b6bdcccc 100644
--- a/config/mk/google_devices/common/BoardConfig-armv9.mk
+++ b/config/mk/google_devices/common/BoardConfig-armv9.mk
@@ -1,3 +1,12 @@
+# LECH OS development builds (LECH_PIXEL_GENERIC_CPU := true in the LECH product) use the generic ARMv8-A
+# target of the LECH OS GSI: the build reuses the system already compiled for the GSI, which fits the disk
+# and time of the build notebook. Release builds keep ARMv9 with memory tagging (MTE) below.
+ifeq ($(LECH_PIXEL_GENERIC_CPU),true)
+TARGET_ARCH := arm64
+TARGET_ARCH_VARIANT := armv8-a
+TARGET_CPU_ABI := arm64-v8a
+TARGET_CPU_VARIANT := generic
+else
 TARGET_ARCH := arm64
 TARGET_ARCH_VARIANT := armv9-a
 TARGET_CPU_ABI := arm64-v8a
@@ -13,3 +22,4 @@ BOARD_KERNEL_CMDLINE += kasan.fault=panic
 ifeq ($(filter memtag_heap,$(SANITIZE_TARGET)),)
 SANITIZE_TARGET := $(strip $(SANITIZE_TARGET) memtag_heap)
 endif
+endif
