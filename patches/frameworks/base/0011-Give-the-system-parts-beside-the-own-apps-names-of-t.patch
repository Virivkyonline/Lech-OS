From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Thu, 12 Nov 2026 13:30:00 +0100
Subject: [PATCH] Give the system parts beside the own apps names of their own
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The app lists of Settings showed two apps named Nastavenia, two named
Súbory, and PDF next to PDF Viewer (owner, 12. 11. 2026): the system
parts that stay beside the own apps of LECH OS have the same names.
Their application names in app lists are now: Settings "Nastavenia
systému", DocumentsUI "Výber súborov", the GrapheneOS PDF viewer
"Zobrazovač PDF" and Launcher3 "Plocha" (other languages: System
settings, File picker, PDF renderer, Home screen). Only the application
name changes (PackageItemInfo of an ApplicationInfo); activities, which
ComponentInfo labels, and the screens keep their titles.
---
 .../java/android/content/pm/LechAppNames.java | 38 +++++++++++++++++--
 .../android/content/pm/PackageItemInfo.java   |  3 +-
 2 files changed, 37 insertions(+), 5 deletions(-)

diff --git a/core/java/android/content/pm/LechAppNames.java b/core/java/android/content/pm/LechAppNames.java
index c1fd896..b18d4f4 100644
--- a/core/java/android/content/pm/LechAppNames.java
+++ b/core/java/android/content/pm/LechAppNames.java
@@ -21,6 +21,11 @@ import java.util.Locale;
  * underscores&gt;), as on the home screen (frameworks/libs/systemui patches 0002 and 0003). Shown wherever Android
  * shows the app: app list and app info in Settings, default apps, permission dialogs, notifications.
  *
+ * <p>System parts that stay beside the own apps of LECH OS get names of their own in the app lists, so that two apps
+ * are never called the same (owner, 12. 11. 2026): Settings ("Nastavenia systému", the screens LECH Nastavenia opens),
+ * DocumentsUI ("Výber súborov", the system file picker), the GrapheneOS PDF viewer ("Zobrazovač PDF", renders the files
+ * of LECH PDF) and Launcher3 ("Plocha"); F-Droid is "Obchod aplikácií". Only the application name changes; screens and activities keep their titles.
+ *
  * @hide
  */
 public final class LechAppNames {
@@ -28,19 +33,45 @@ public final class LechAppNames {
     /** Only this name is replaced: activities and share targets of the app keep their own labels. */
     private static final String BROWSER_NAME = "Vanadium";
     private static final String ICONS_PACKAGE = "lech.os.ikony";
+    /** Package, Slovak name, name in other languages. */
+    private static final String[][] SYSTEM_PARTS = {
+        {"com.android.settings", "Nastavenia systému", "System settings"},
+        {"com.android.documentsui", "Výber súborov", "File picker"},
+        {"app.grapheneos.pdfviewer", "Zobrazovač PDF", "PDF renderer"},
+        {"com.android.launcher3", "Plocha", "Home screen"},
+        {"org.fdroid.fdroid", "Obchod aplikácií", "App store"},
+    };
 
     private LechAppNames() {
     }
 
-    /** The LECH OS name for the label of a package item, or the label itself. */
+    /**
+     * The LECH OS name for the label of a package item, or the label itself. {@code application}: the item is the
+     * application itself (its name in app lists), not a permission or another item of the package.
+     */
     @NonNull
-    public static CharSequence label(@Nullable String packageName, @NonNull CharSequence label) {
-        if (!BROWSER.equals(packageName) || !BROWSER_NAME.contentEquals(label)) {
+    public static CharSequence label(@Nullable String packageName, @NonNull CharSequence label,
+            boolean application) {
+        if (packageName == null) {
             return label;
         }
+        if (BROWSER.equals(packageName) && BROWSER_NAME.contentEquals(label)) {
+            return slovak() ? "Prehliadač" : "Browser";
+        }
+        if (application) {
+            for (String[] part : SYSTEM_PARTS) {
+                if (part[0].equals(packageName)) {
+                    return slovak() ? part[1] : part[2];
+                }
+            }
+        }
+        return label;
+    }
+
+    private static boolean slovak() {
         LocaleList locales = Resources.getSystem().getConfiguration().getLocales();
         Locale locale = locales.isEmpty() ? null : locales.get(0);
-        return locale != null && "sk".equals(locale.getLanguage()) ? "Prehliadač" : "Browser";
+        return locale != null && "sk".equals(locale.getLanguage());
     }
 
     /**
diff --git a/core/java/android/content/pm/PackageItemInfo.java b/core/java/android/content/pm/PackageItemInfo.java
index b5a5778..cc082f2 100644
--- a/core/java/android/content/pm/PackageItemInfo.java
+++ b/core/java/android/content/pm/PackageItemInfo.java
@@ -237,7 +237,8 @@ public class PackageItemInfo {
             CharSequence label = pm.getText(packageName, labelRes, getApplicationInfo());
             if (label != null) {
                 // LECH OS: the LECH OS name of a prebuilt app (LechAppNames).
-                return LechAppNames.label(packageName, label.toString().trim());
+                return LechAppNames.label(packageName, label.toString().trim(),
+                        this instanceof ApplicationInfo);
             }
         }
         if (name != null) {
