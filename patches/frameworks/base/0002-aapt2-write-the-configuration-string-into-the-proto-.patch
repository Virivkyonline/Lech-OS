From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Fri, 6 Nov 2026 12:00:00 +0100
Subject: [PATCH] aapt2: write the configuration string into the proto format
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

tools/arsclib of GrapheneOS groups and names the resources of the Pixel
overlays by the configuration string as aapt2 writes it ("land-v31"…).
GrapheneOS keeps it in a new field of the proto Configuration that aapt2
fills when it serializes resources; do the same. adevtool uses arsclib
when it generates the vendor module of the Pixel 9 for LECH OS
(task E2-11b, manifests/lech-pixel.xml).
---
 tools/aapt2/Configuration.proto             | 4 ++++
 tools/aapt2/format/proto/ProtoSerialize.cpp | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/tools/aapt2/Configuration.proto b/tools/aapt2/Configuration.proto
index c27c824..56d3c69 100644
--- a/tools/aapt2/Configuration.proto
+++ b/tools/aapt2/Configuration.proto
@@ -218,2 +218,6 @@ message Configuration {
   string product = 25;
+
+  // LECH OS: the configuration as aapt2 writes it ("land-v31"…), as in GrapheneOS: tools/arsclib groups the
+  // resources of the Pixel overlays by it (task E2-11b).
+  string stringified = 28;
 }
diff --git a/tools/aapt2/format/proto/ProtoSerialize.cpp b/tools/aapt2/format/proto/ProtoSerialize.cpp
index 6e0cf6f..b1abfa4 100644
--- a/tools/aapt2/format/proto/ProtoSerialize.cpp
+++ b/tools/aapt2/format/proto/ProtoSerialize.cpp
@@ -65,2 +65,4 @@ static pb::Visibility::Level SerializeVisibilityToPb(Visibility::Level state) {
 void SerializeConfig(const ConfigDescription& config, pb::Configuration* out_pb_config) {
+  // LECH OS: also the configuration string (Configuration.proto, field stringified).
+  out_pb_config->set_stringified(config.to_string());
   out_pb_config->set_mcc(config.mcc);
-- 
