From d0715f2e45b9acc281697f8b21e2150bea1b4064 Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Mon, 16 Nov 2026 10:30:00 +0000
Subject: [PATCH] Czech texts of call recording

The Czech translation of the call recording texts of the base, next to the
Slovak one.
---
 .../impl/res/values-cs/strings_lech.xml       |  9 ++++++++
 .../incallui/res/values-cs/strings_ext.xml    | 23 +++++++++++++++++++
 2 files changed, 32 insertions(+)
 create mode 100644 java/com/android/incallui/incall/impl/res/values-cs/strings_lech.xml
 create mode 100644 java/com/android/incallui/res/values-cs/strings_ext.xml

diff --git a/java/com/android/incallui/incall/impl/res/values-cs/strings_lech.xml b/java/com/android/incallui/incall/impl/res/values-cs/strings_lech.xml
new file mode 100644
index 0000000..057eebb
--- /dev/null
+++ b/java/com/android/incallui/incall/impl/res/values-cs/strings_lech.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- LECH OS: Czech texts of automatic call recording (the base has them in English only). -->
+<resources>
+  <string name="auto_call_recording_started_message">Automatické nahrávání hovoru je zapnuté</string>
+  <string name="auto_call_recording_will_start_message">Hovor se nahraje automaticky</string>
+  <string name="auto_call_recording_mic_permission_message">Je potřeba přístup k mikrofonu</string>
+  <string name="auto_call_recording_contacts_permission_message">Je potřeba přístup ke kontaktům</string>
+  <string name="auto_call_recording_permissions_message">Je potřeba mikrofon a kontakty</string>
+</resources>
diff --git a/java/com/android/incallui/res/values-cs/strings_ext.xml b/java/com/android/incallui/res/values-cs/strings_ext.xml
new file mode 100644
index 0000000..1c1fb1d
--- /dev/null
+++ b/java/com/android/incallui/res/values-cs/strings_ext.xml
@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- LECH OS: Czech texts of call recording (the base has them in English only). -->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="call_recording_failed_message">Nahrávání hovoru se nepodařilo spustit</string>
+    <string name="call_recording_error_title">Nahrávání hovoru selhalo</string>
+    <string name="call_recording_error_message">Nahrávání hovoru se zastavilo kvůli chybě</string>
+    <string name="call_recording_file_location">Nahrávka hovoru je uložena v <xliff:g id="filename">%1$s</xliff:g></string>
+    <string name="call_recording_permission_required_title">Je potřeba oprávnění k mikrofonu</string>
+    <string name="call_recording_permission_required_message">Nahrávání hovorů potřebuje přístup k mikrofonu. Povolte ho v Nastavení a zkuste to znovu.</string>
+    <string name="call_recording_permission_open_settings">Otevřít nastavení</string>
+    <string name="call_recording_unlock_to_record_message">K nahrávání hovorů odemkněte telefon</string>
+    <string name="onscreenCallRecordText">Nahrát hovor</string>
+    <string name="onscreenCallRecordingText">Nahrává se – <xliff:g id="duration" example="00:10">%1$s</xliff:g></string>
+    <string name="onscreenStopCallRecordText">Zastavit nahrávání</string>
+    <string name="call_recording_warning_settings_title">Upozornění k nahrávání hovorů</string>
+    <string name="recording_time_text">Nahrávání</string>
+    <string name="recording_warning_title">Zapnout nahrávání hovorů?</string>
+    <string name="recording_warning_text">Upozornění:
+    Za dodržení všech zákonů, předpisů a pravidel, které se vztahují na nahrávání hovorů a na používání nebo šíření nahrávek, odpovídáte v plném rozsahu vy.
+    Dalším používáním nahrávání hovorů potvrzujete, že jste si toto upozornění přečetli a že LECH OS nenese žádnou odpovědnost za případné následky
+    používání funkce nahrávání hovorů.
+    </string>
+</resources>
-- 
2.43.0

