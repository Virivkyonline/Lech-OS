From 8a3c608ae2a60c34a5cc56b5c0b7fee92e9d8fcc Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Sat, 14 Nov 2026 18:40:00 +0000
Subject: [PATCH] Home screen of a new phone with the apps of LECH OS

The launcher of the GrapheneOS base (ADR-0012) takes its grids from
res-stock: the Pixel 9 uses the grid "medium" with
res-stock/xml/default_workspace_4x6.xml. Its generic entries put the
Dialer and the App Store of the base on the home screen and left the
places of Messages and Gallery empty (Pixel 9, 14. 11. 2026). The layout
now names the apps of LECH OS: dock Telefon, Spravy, Prehliadac,
Fotoaparat; bottom row Obchod aplikacii (F-Droid), Galeria, Mapy
(Organic Maps), Nastavenia.
---
 res-stock/xml/default_workspace_4x6.xml | 31 +++++++++++++++++++++----
 1 file changed, 27 insertions(+), 4 deletions(-)

diff --git a/res-stock/xml/default_workspace_4x6.xml b/res-stock/xml/default_workspace_4x6.xml
index f528df6..1d099d4 100644
--- a/res-stock/xml/default_workspace_4x6.xml
+++ b/res-stock/xml/default_workspace_4x6.xml
@@ -1,17 +1,24 @@
 <?xml version="1.0" encoding="utf-8"?>
 <favorites>
+    <!-- LECH OS: the home screen of a new phone with the apps of LECH OS, named directly. The generic entries of
+         the base (the app for DIAL, "the app market"...) put the Dialer and the App Store of the base there and
+         left the places of Messages and Gallery empty (Pixel 9, 14. 11. 2026; grid "medium", launcher_4_by_6.db).
+         Activities verified on the phone (cmd package resolve-activity).
+         Dock: Telefón, Správy, Prehliadač, Fotoaparát. Bottom row: Obchod aplikácií, Galéria, Mapy, Nastavenia. -->
     <favorite
         xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
         launcher:container="-101"
         launcher:screen="0"
-        launcher:uri="#Intent;action=android.intent.action.DIAL;end"
+        launcher:packageName="lech.os.kontakty"
+        launcher:className="lech.os.kontakty.PhoneActivity"
         launcher:x="0"
         launcher:y="0" />
     <favorite
         xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
         launcher:container="-101"
         launcher:screen="1"
-        launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MESSAGING;end"
+        launcher:packageName="lech.os.spravy"
+        launcher:className="lech.os.spravy.MainActivity"
         launcher:x="1"
         launcher:y="0" />
     <favorite
@@ -31,13 +38,29 @@
     <favorite
         xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
         launcher:screen="0"
-        launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MARKET;end"
+        launcher:packageName="org.fdroid.fdroid"
+        launcher:className="org.fdroid.IconActivity"
         launcher:x="0"
         launcher:y="-1" />
     <favorite
         xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
         launcher:screen="0"
-        launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_GALLERY;end"
+        launcher:packageName="lech.os.galeria"
+        launcher:className="lech.os.galeria.MainActivity"
+        launcher:x="1"
+        launcher:y="-1" />
+    <favorite
+        xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
+        launcher:screen="0"
+        launcher:packageName="app.organicmaps"
+        launcher:className="app.organicmaps.DownloadResourcesActivity"
         launcher:x="2"
         launcher:y="-1" />
+    <favorite
+        xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3"
+        launcher:screen="0"
+        launcher:packageName="lech.os.nastavenia"
+        launcher:className="lech.os.nastavenia.MainActivity"
+        launcher:x="3"
+        launcher:y="-1" />
 </favorites>
-- 
