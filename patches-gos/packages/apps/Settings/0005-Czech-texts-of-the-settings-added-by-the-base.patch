+    <string name="cross_profile_clipboard_access_allow_defaults_summary">Schránka se sdílí s nadřazeným uživatelem a jeho dalšími profily podle výchozího nastavení systému, oběma směry.</string>
+    <string name="cross_profile_clipboard_access_allow_import_defaults_title">Výchozí jen pro přijímání</string>
+    <string name="cross_profile_clipboard_access_allow_import_defaults_summary">Schránka se podle výchozího nastavení systému přijímá od nadřazeného uživatele a jeho dalších profilů.</string>
