From baa0c49eb40d2da571b720464f5027ff20e9e82a Mon Sep 17 00:00:00 2001
From: LECH OS <dev@lech-os.invalid>
Date: Mon, 16 Nov 2026 10:35:00 +0000
Subject: [PATCH] Czech names of the keyboard without Android (AOSP), Czech
 predictive text switch
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

As for Slovak: the keyboard is called "Klávesnice" and the predictive text
switch of LECH OS has Czech texts.
---
 java/res/values-cs/lech_strings.xml    | 6 ++++++
 java/res/values-cs/strings-appname.xml | 8 ++++----
 2 files changed, 10 insertions(+), 4 deletions(-)
 create mode 100644 java/res/values-cs/lech_strings.xml

diff --git a/java/res/values-cs/lech_strings.xml b/java/res/values-cs/lech_strings.xml
new file mode 100644
index 0000000..ed50b88
--- /dev/null
+++ b/java/res/values-cs/lech_strings.xml
@@ -0,0 +1,6 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- LECH OS: Czech texts of the predictive text switch. -->
+<resources>
+    <string name="lech_predictive_text">Prediktivní text</string>
+    <string name="lech_predictive_text_summary">Navrhovat slova při psaní</string>
+</resources>
diff --git a/java/res/values-cs/strings-appname.xml b/java/res/values-cs/strings-appname.xml
index 51e3297..1eadfc9 100644
--- a/java/res/values-cs/strings-appname.xml
+++ b/java/res/values-cs/strings-appname.xml
@@ -20,8 +20,8 @@
 
 <resources xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
-    <string name="english_ime_name" msgid="4475547506953371028">"Klávesnice Android (AOSP)"</string>
-    <string name="spell_checker_service_name" msgid="7417621022652876777">"Kontrola pravopisu Android (AOSP)"</string>
-    <string name="english_ime_settings" msgid="1497566567404939275">"Nastavení klávesnice Android (AOSP)"</string>
-    <string name="android_spell_checker_settings" msgid="2821003654878860820">"Nastavení kontroly pravopisu Android (AOSP)"</string>
+    <string name="english_ime_name" msgid="4475547506953371028">"Klávesnice"</string>
+    <string name="spell_checker_service_name" msgid="7417621022652876777">"Kontrola pravopisu"</string>
+    <string name="english_ime_settings" msgid="1497566567404939275">"Nastavení klávesnice"</string>
+    <string name="android_spell_checker_settings" msgid="2821003654878860820">"Nastavení kontroly pravopisu"</string>
 </resources>
-- 
