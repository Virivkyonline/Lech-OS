+    <string name="bg_dexopt_completed_notif_ch_title">Optimalizace aplikací je dokončena</string>
+    <string name="bg_dexopt_completed_notif_title">Je potřeba restartovat aplikace</string>
+    <string name="bg_dexopt_completed_notif_text">Optimalizace aplikací je dokončena. Klepnutím restartujete optimalizované aplikace.</string>
+    <string name="notif_channel_exploit_protection">Ochrana před útoky</string>
