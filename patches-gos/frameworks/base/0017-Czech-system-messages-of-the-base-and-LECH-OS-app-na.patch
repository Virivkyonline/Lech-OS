+    <string name="fsck_error_notif_title">Byla zjištěna chyba systému souborů</string>
+    <string name="notif_memtag_crash_title">Označování paměti zjistilo chybu v %1$s</string>
+    <string name="notif_hmalloc_crash_title">hardened_malloc zjistil chybu v %1$s</string>
+    <string name="notif_memory_dcl_title">Aplikace %1$s se pokusila načíst kód z paměti (DCL)</string>
+    <string name="notif_storage_dcl_title">Aplikace %1$s se pokusila načíst kód z úložiště (DCL)</string>
+    <string name="usb_port_security_error_title">Ochrana portu USB-C selhala</string>
+    <string name="clipboard_access_blocked">Aplikaci %1$s byl zablokován přístup ke schránce</string>
+</resources>
-- 
